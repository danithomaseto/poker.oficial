# Sem estas variáveis o site funciona sem contas: tutorial, treino, baralhos e progresso
# ficam salvos só no aparelho. Passo a passo em docs/supabase.md.

# apps/web (públicas: podem ir para o navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# A integração Supabase da Vercel cria esta no lugar da de cima; qualquer uma serve.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Endereço usado na mensagem de convite (padrão: https://poker-oficial.vercel.app)
# NEXT_PUBLIC_SITE_URL=

# apps/game-server (fase 4; nunca no web nem no repositório)
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=

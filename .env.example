# Nenhuma variável é necessária nesta etapa (só o site público).
# A partir da fase 2 entram, por exemplo:
#
# apps/web
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_GAME_SERVER_URL=
#
# apps/game-server (nunca no web nem no repositório)
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
